@using Microsoft.AspNetCore.Identity
@model IReadOnlyList<AppUser>

<a asp-action="Create" class="btn btn-primary mb-2">Create new User</a>


@if (ViewBag.Errors is IEnumerable<IdentityError> errors && errors.Count() > 0)
{
    <ul>
        @foreach (var error in errors)
        {
            <li>@error.Description</li>
        }
    </ul>
}


@if (Model is null || Model.Count == 0)
{
    <div class="alert alert-primary" role="alert">
        NO Users
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Full Name</th>
                <th scope="col">Email</th>
                <th scope="col">Roles</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach ((int index, AppUser user) in Model.Index())
            {
                <tr>
                    <td>@(index + 1)</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td i-user="@user.Id"></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-secondary">Edit</a>
                        <a asp-action="ChangePassword" asp-route-id="@user.Id" class="btn btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }


        </tbody>
    </table>
}