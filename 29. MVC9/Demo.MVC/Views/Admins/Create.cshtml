@using Demo.BLL.Interfaces
@model UserViewModel
@inject IDepartmentRepository departmentRepository

@{
    IEnumerable<SelectListItem> listItems = (await departmentRepository.GetAllAsync())
    .Select(d => new SelectListItem
    {
        Value = d.Id.ToString(),
        Text = d.Name,
    });

    IEnumerable<SelectListItem> roles = AppRoles.Roles.Select(r => new SelectListItem
    {
        Value = r,
        Text = r,
    });

    // if (ViewBag.Deprts is List<Department> departments)
    // {
    //     listItems = departments.Select(d => new SelectListItem
    //     {
    //         Value = d.Id.ToString(),
    //         Text = d.Name,
    //     });
    // }
}

<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="All"></div>
    <div class="row">
        <div class="col-6 mb-2">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName"></span>
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Department" class="form-label"></label>
            <select asp-for="Department" asp-items="@listItems" class="form-select">
                <option value="0">--choose Department--</option>
            </select>
        </div>
        <div class="col-6 mb-2">
            <label asp-for="SelectedRoles" class="form-label"></label>
            <select asp-for="SelectedRoles" asp-items="@roles" multiple class="form-select">
            </select>
        </div>

        <div class="col-6 mb-2">
            <label asp-for="Image" class="form-label"></label>
            <input type="file" accept="image/*" asp-for="Image" />
        </div>

        <div class="col-6 mb-2">
            <img id="preview" width="250" style="display:none; margin-top:15px;" />
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        new Choices('#SelectedRoles', {
            removeItemButton: true,
            searchEnabled: true,
            placeholder: true,
            placeholderValue: 'Select Roles',
            searchPlaceholderValue: 'Search roles...'
        })


        document.getElementById('Image').onchange = function () {

            let file = this.files[0];

            if (file) { 
                let preview = document.getElementById('preview');

                preview.src = URL.createObjectURL(file);
                preview.style.display = "block";
            }

        };
    </script>
}