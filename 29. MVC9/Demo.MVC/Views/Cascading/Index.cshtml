@using Demo.MVC.Controllers
@model List<State>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Location Selector</h4>
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <label for="stateSelect" class="form-label">State</label>
                        <select id="stateSelect" class="form-select">
                            <option value="">-- select State --</option>
                            @foreach (var state in Model)
                            {
                                <option value="@state.Id">@state.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="citySelect" class="form-label">City</label>
                        <select id="citySelect" class="form-select" disabled>
                            <option value="">-- select City --</option>
                        </select>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        document.getElementById('stateSelect')?.addEventListener('change', async function () {
            debugger;
            let stateId = this.value;

            let citySelect = document.getElementById('citySelect');

            citySelect.innerHTML = '<option value="">-- select City --</option>';
            citySelect.disabled = true;

            if (stateId == "") return;

            //ajax call
            let responce = await fetch('/Cascading/GetCities?stateId=' + stateId);
            let cities = await responce.json();

            cities.forEach(city => {
                let option = document.createElement('option')

                option.value = city.id
                option.textContent = city.name

                citySelect?.appendChild(option);
            });
            citySelect.disabled = false;
        })
    </script>
}