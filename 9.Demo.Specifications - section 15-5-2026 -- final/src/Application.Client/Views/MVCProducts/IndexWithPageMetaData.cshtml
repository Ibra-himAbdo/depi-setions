@using Application.Core.Models
@model ProductPageMetaData
@inject IUnitOfWork unitOfWork

@{
    ViewData["Title"] = Resource.Products;

    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;

    int[] pageSizes = [5, 10, 15, 25, 50];

    var oldSearch = Context.Request.Query[nameof(Model.Search)].ToString();


    var oldSort = Context.Request.Query[nameof(Model.SortBy)].ToString();

    var sortList = Enum.GetValues(typeof(ProductSort)).Cast<ProductSort>().Select(e => new { Value = e.ToString(), Text = e.ToString() }).ToList();

    var oldMinPrice = Context.Request.Query[nameof(Model.MinPrice)].ToString();
    var oldMaxPrice = Context.Request.Query[nameof(Model.MaxPrice)].ToString();


    var brandItems = await unitOfWork.Repository<ProductBrand>().ProjectToAsync<SelectListItem>();


    var categoryItems = await unitOfWork.Repository<ProductCategory>().ProjectAsync(e => new SelectListItem
    {
        Value = e.Id.ToString(),
        Text = isRtl ? e.NameSecondLanguage : e.Name
    });

    var maxPrice = await unitOfWork.Repository<Product>().GetMaxAsync(e => e.Price);
    var minPrice = await unitOfWork.Repository<Product>().GetMinAsync(e => e.Price);

}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="m-0">@Resource.Products</h2>
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted">@Model.TotalItemsInDb @Resource.Items</span>
            <a class="btn btn-primary" asp-action="Create">@Resource.Create</a>
        </div>
    </div>

    @if (Model.Data is null || Model.Data.Count == 0)
    {
        <div class="alert alert-info mb-0">@Resource.NoProductsFound</div>
    }
    else
    {

        <div class="row mb-2 ">
            <div class="col-md-12">

                <form asp-action="IndexWithPageMetaData" method="get">
                    <div class="row mb-2">

                        <input class="d-none" asp-for="CurrentPageIndex" value="1" />
                        <input class="d-none" asp-for="CurrentPageSize" value="@Model.CurrentPageSize" />

                        <div class="col-md-8 mb-2">
                            <label class="form-label me-2" asp-for="Search">Search</label>
                            <input class="form-control" asp-for="Search" value="@oldSearch" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label me-2" asp-for="SortBy">Sort By</label>
                            <select asp-for="SortBy" class="form-select">
                                @foreach (var sort in sortList)
                                {
                                    <option value="@sort.Value" class="@(sort.Value == oldSort ? "selected" : "")">@sort.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-2">
                            <label class="form-label me-2" asp-for="BrandId">Brands</label>
                            <select asp-for="BrandId" class="form-select" asp-items="brandItems">
                                <option value="@null">-- Choose Brand --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-2">
                            <label class="form-label me-2" asp-for="CategoryId">Categories</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="categoryItems">
                                <option value="@null">-- Choose Category --</option>
                            </select>
                        </div>

                        <div class="col-md-12 px-3 mb-2">

                            <input class="d-none" id="max-price-value" value="@maxPrice" readonly />
                            <input class="d-none" id="min-price-value" value="@minPrice" readonly />

                            <p id="price-text" class="form-label"></p>
                            <div id="price-slider"></div>

                            <input class="d-none" asp-for="MinPrice" />
                            <input class="d-none" asp-for="MaxPrice" />

                        </div>

                        <div class="d-flex align-items-end">
                            <button type="submit" class="btn btn-primary @(isRtl ? "me-auto" : "ms-auto")">Search</button>
                        </div>

                    </div>

                </form>



                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Page size - @Model.CurrentPageSize
                    </button>
                    <ul class="dropdown-menu">
                        @foreach (var size in pageSizes)
                        {
                            <li>
                                <a class="dropdown-item @(size == Model.CurrentPageSize ? "active" : "")"
                                   asp-action="IndexWithPageMetaData"
                                   asp-route-Search="@oldSearch"
                                   asp-route-CurrentPageSize="@size">
                                    @size
                                </a>
                            </li>
                        }
                    </ul>
                </div>


            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>@Resource.ProductName</th>
                        <th class="text-end">@Resource.ProductPrice</th>
                        <th>@Resource.ProductBrand</th>
                        <th>@Resource.ProductCategory</th>
                        <th class="text-end">@Resource.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Data)
                    {
                        <tr>
                            <td>@(isRtl? product.NameSecondLanguage: product.Name)</td>
                            <td class="text-end">@product.Price.ToString("0.00")</td>
                            <td>@(isRtl? product.Brand?.NameSecondLanguage ?? "-" : product.Brand?.Name ?? "-")</td>
                            <td>@(isRtl? product.Category?.NameSecondLanguage ?? "-" : product.Category?.Name ?? "-")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Update"
                                   asp-route-id="@product.Id">
                                    @Resource.Update
                                </a>
                                <a class="btn btn-sm btn-outline-danger ms-1"
                                   asp-action="Delete"
                                   asp-route-id="@product.Id">
                                    @Resource.Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-center">
                @if (!Model.HasPrevious)
                {
                    <li class="page-item disabled">
                        <a class="page-link">Previous</a>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="IndexWithPageMetaData"
                           asp-route-CurrentPageSize="@Model.CurrentPageSize"
                           asp-route-Search="@oldSearch"
                           asp-route-CurrentPageIndex="@(Model.CurrentPageIndex - 1)">
                            Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-action="IndexWithPageMetaData"
                           asp-route-CurrentPageSize="@Model.CurrentPageSize"
                           asp-route-Search="@oldSearch"
                           asp-route-CurrentPageIndex="@i">
                            @i
                        </a>
                    </li>
                }

                @if (!Model.HasNext)
                {
                    <li class="page-item disabled">
                        <a class="page-link">Next</a>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="IndexWithPageMetaData"
                           asp-route-CurrentPageIndex="@(Model.CurrentPageIndex + 1)"
                           asp-route-Search="@oldSearch"
                           asp-route-CurrentPageSize="@Model.CurrentPageSize">
                            Next
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>



@section Scripts {
    <script>

        const dbMinPrice = parseFloat($("#min-price-value").val()) || 0;
        const dbMaxPrice = parseFloat($("#max-price-value").val()) || 1000;

        // old values from query string
        const oldMinPrice = '@oldMinPrice';
        const oldMaxPrice = '@oldMaxPrice';

        // use old values if exist, otherwise use db values
        const currentMinPrice = oldMinPrice !== ''
            ? parseFloat(oldMinPrice)
            : dbMinPrice;

        const currentMaxPrice = oldMaxPrice !== ''
            ? parseFloat(oldMaxPrice)
            : dbMaxPrice;

        $("#price-slider").slider({
            range: true,
            min: dbMinPrice,
            max: dbMaxPrice,
            values: [currentMinPrice, currentMaxPrice],

            slide: function (_, ui) {

                $("#MinPrice").val(ui.values[0]);
                $("#MaxPrice").val(ui.values[1]);

                $("#price-text").text(ui.values[0] + " - " + ui.values[1]);
            }
        });

        // initialize hidden inputs
        $("#MinPrice").val(currentMinPrice);
        $("#MaxPrice").val(currentMaxPrice);

        // initialize text
        $("#price-text").text(currentMinPrice + " - " + currentMaxPrice);

    </script>
}