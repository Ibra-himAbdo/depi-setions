@using Demo.BLL.Interfaces
@model UserViewModel
@inject IDepartmentRepository departmentRepository

@{
    IEnumerable<SelectListItem> listItems = (await departmentRepository.GetAllAsync())
    .Select(d => new SelectListItem
    {
        Value = d.Id.ToString(),
        Text = d.Name,
    }); 
    // if (ViewBag.Deprts is List<Department> departments)
    // {
    //     listItems = departments.Select(d => new SelectListItem
    //     {
    //         Value = d.Id.ToString(),
    //         Text = d.Name,
    //     });
    // }
}

<form asp-action="Create">
    <div asp-validation-summary="All"></div>
    <div class="row">
        <div class="col-6 mb-2">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName"></span>
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Department" class="form-label"></label>
            <select asp-for="Department" asp-items="@listItems" class="form-select">
                <option value="0">--choose Department--</option>
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}