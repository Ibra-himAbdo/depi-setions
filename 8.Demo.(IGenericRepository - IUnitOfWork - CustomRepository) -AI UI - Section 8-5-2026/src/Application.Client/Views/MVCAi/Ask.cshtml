@{
    ViewData["Title"] = "Basic Chat";
}

<div class="mb-4">
    <a asp-controller="MVCAi" asp-action="Index" class="link link-hover text-sm text-base-content/70">
        ← Back to AI Assistant
    </a>
</div>

<div class="card bg-base-200 shadow-xl">
    <div class="card-body gap-0 p-0">
        <div class="flex flex-wrap items-center gap-3 bg-primary p-4 text-primary-content">
            <span class="text-2xl">💬</span>
            <div>
                <h2 class="text-lg font-bold">Basic Chat</h2>
                <p class="text-sm opacity-90">
                    <span class="badge badge-outline border-primary-content/50 text-primary-content">Stateless</span>
                    Each message is sent independently — no memory between turns.
                </p>
            </div>
        </div>

        <div id="chatMessages" class="flex max-h-[26rem] min-h-[12rem] flex-col gap-3 overflow-y-auto bg-base-100 p-4">
            <div class="chat chat-start">
                <div class="chat-bubble chat-bubble-secondary">👋 Hello! I'm your AI assistant. Ask me anything.</div>
            </div>
        </div>

        <div class="join join-vertical w-full border-t border-base-300 p-3 sm:join-horizontal">
            <textarea id="userInput" rows="1" placeholder="Type a message…" maxlength="2000"
                      class="textarea textarea-bordered join-item min-h-12 grow text-base"></textarea>
            <button id="sendBtn" type="button" class="btn btn-primary join-item px-6" onclick="sendMessage()">Send ↑</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const messagesEl = document.getElementById('chatMessages');
        const inputEl    = document.getElementById('userInput');
        const sendBtn    = document.getElementById('sendBtn');

        inputEl.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        function appendBubble(text, type) {
            const wrap = document.createElement('div');
            wrap.className = type === 'user' ? 'chat chat-end' : 'chat chat-start';
            const bubble = document.createElement('div');
            bubble.className = type === 'user'
                ? 'chat-bubble chat-bubble-primary'
                : 'chat-bubble chat-bubble-secondary';
            bubble.textContent = text;
            wrap.appendChild(bubble);
            messagesEl.appendChild(wrap);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function showTyping() {
            const wrap = document.createElement('div');
            wrap.className = 'chat chat-start';
            wrap.id = 'typingIndicator';
            const inner = document.createElement('div');
            inner.className = 'chat-bubble';
            inner.innerHTML = '<span class="loading loading-dots loading-md text-primary"></span>';
            wrap.appendChild(inner);
            messagesEl.appendChild(wrap);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function hideTyping() {
            document.getElementById('typingIndicator')?.remove();
        }

        async function sendMessage() {
            const msg = inputEl.value.trim();
            if (!msg) return;

            inputEl.value = '';
            sendBtn.disabled = true;

            appendBubble(msg, 'user');
            showTyping();

            const reply = await api('/Ai/AskAsync', 'POST', msg);

            hideTyping();

            if (reply !== null) {
                appendBubble(reply, 'ai');
            }

            sendBtn.disabled = false;
            inputEl.focus();
        }
    </script>
}
