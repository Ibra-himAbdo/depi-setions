@{
    ViewData["Title"] = "Standard Chat - Basic Interaction";
}

<div class="mb-6">
    <a asp-controller="MVCAi" asp-action="Index" class="group inline-flex items-center gap-2 text-sm font-bold text-base-content/50 transition-colors hover:text-primary">
        <i class="fa-solid fa-chevron-left transition-transform group-hover:-translate-x-1"></i>
        BACK TO HUB
    </a>
</div>

<div class="mx-auto max-w-4xl">
    <div class="card bg-base-100 border border-base-300 shadow-2xl overflow-hidden min-h-[600px] flex flex-col">
        @* Header *@
        <div class="flex items-center gap-4 bg-linear-to-r from-primary/10 via-base-100 to-transparent px-6 py-4 border-b border-base-300">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary text-primary-content shadow-lg shadow-primary/20">
                <i class="fa-solid fa-comment-dots text-xl"></i>
            </div>
            <div>
                <h2 class="text-xl font-black tracking-tight">Standard Interface</h2>
                <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest opacity-50">
                    <span class="badge badge-xs badge-outline border-primary/30 text-primary">Stateless</span>
                    Single-turn query logic
                </div>
            </div>
        </div>

        @* Messages Area *@
        <div id="chatMessages" class="flex-1 max-h-[500px] overflow-y-auto p-6 space-y-6 bg-[radial-gradient(circle_at_top_right,_var(--color-base-200)_0%,_transparent_100%)]">
            <div class="chat chat-start">
                <div class="chat-image avatar">
                    <div class="w-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-bold shadow-md">
                        AI
                    </div>
                </div>
                <div class="chat-header opacity-50 text-[10px] font-black mb-1 px-1">STDRD_BOT</div>
                <div class="chat-bubble bg-base-200 text-base-content border border-base-300 shadow-sm leading-relaxed max-w-[90%]">
                    👋 Hello! I'm in <strong>Standard Mode</strong>. I can answer your questions quickly, but I won't remember our conversation after each turn. How can I help?
                </div>
            </div>
        </div>

        @* Input Area *@
        <div class="p-6 bg-base-200/30 border-t border-base-300">
            <div class="relative group">
                <textarea id="userInput" rows="1" placeholder="Type your query..." 
                          class="textarea textarea-bordered w-full min-h-[60px] bg-base-100 focus:ring-4 focus:ring-primary/5 transition-all text-base pr-20 py-4 resize-none shadow-inner"></textarea>
                
                <div class="absolute right-3 bottom-3 flex items-center gap-2">
                    <button id="sendBtn" type="button" class="btn btn-primary btn-md shadow-lg shadow-primary/20" onclick="sendMessage()">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </div>
            <div class="mt-3 flex items-center justify-between px-2 text-[10px] font-bold uppercase tracking-widest opacity-40">
                <span>Fast response enabled</span>
                <span>Max 2000 chars</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const messagesEl = document.getElementById('chatMessages');
    const inputEl    = document.getElementById('userInput');
    const sendBtn    = document.getElementById('sendBtn');

    // Auto-expand textarea
    inputEl.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = (this.scrollHeight) + 'px';
    });

    inputEl.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    function appendBubble(text, type) {
        const wrap = document.createElement('div');
        wrap.className = type === 'user' ? 'chat chat-end' : 'chat chat-start';
        
        const header = document.createElement('div');
        header.className = 'chat-header opacity-50 text-[10px] font-black mb-1 px-1';
        header.textContent = type === 'user' ? 'GUEST_USER' : 'STDRD_BOT';

        const img = document.createElement('div');
        img.className = 'chat-image avatar';
        img.innerHTML = type === 'user' 
            ? '<div class="w-10 rounded-xl bg-neutral text-neutral-content flex items-center justify-center font-bold shadow-md">ME</div>'
            : '<div class="w-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-bold shadow-md">AI</div>';

        const bubble = document.createElement('div');
        bubble.className = type === 'user'
            ? 'chat-bubble bg-primary text-primary-content shadow-lg shadow-primary/10 border-none max-w-[90%]'
            : 'chat-bubble bg-base-200 text-base-content border border-base-300 shadow-sm leading-relaxed max-w-[90%]';
        
        bubble.textContent = text;
        
        wrap.appendChild(img);
        wrap.appendChild(header);
        wrap.appendChild(bubble);
        messagesEl.appendChild(wrap);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function showTyping() {
        const wrap = document.createElement('div');
        wrap.className = 'chat chat-start';
        wrap.id = 'typingIndicator';
        const img = document.createElement('div');
        img.className = 'chat-image avatar';
        img.innerHTML = '<div class="w-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-bold shadow-md">AI</div>';
        const inner = document.createElement('div');
        inner.className = 'chat-bubble bg-base-200 border border-base-300 flex items-center py-4 px-6';
        inner.innerHTML = '<span class="loading loading-dots loading-md text-primary"></span>';
        wrap.appendChild(img);
        wrap.appendChild(inner);
        messagesEl.appendChild(wrap);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function hideTyping() {
        document.getElementById('typingIndicator')?.remove();
    }

    async function sendMessage() {
        const msg = inputEl.value.trim();
        if (!msg) return;

        inputEl.value = '';
        inputEl.style.height = 'auto';
        sendBtn.disabled = true;

        appendBubble(msg, 'user');
        showTyping();

        const reply = await api('/Ai/AskAsync', 'POST', msg);

        hideTyping();

        if (reply !== null) {
            appendBubble(reply, 'ai');
        }

        sendBtn.disabled = false;
        inputEl.focus();
    }
</script>
}

