@{
    ViewData["Title"] = "Neural Core - Advanced Chat";
}

<div class="mb-6">
    <a asp-controller="MVCAi" asp-action="Index" class="group inline-flex items-center gap-2 text-sm font-bold text-base-content/50 transition-colors hover:text-primary">
        <i class="fa-solid fa-chevron-left transition-transform group-hover:-translate-x-1"></i>
        BACK TO HUB
    </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    @* Main Chat Column *@
    <div class="lg:col-span-8 flex flex-col">
        <div class="card bg-base-100 border border-base-300 shadow-2xl overflow-hidden flex-1 min-h-[600px]">
            @* Header *@
            <div class="flex items-center justify-between bg-linear-to-r from-primary/10 via-base-100 to-transparent px-6 py-4 border-b border-base-300">
                <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary text-primary-content shadow-lg shadow-primary/20">
                        <i class="fa-solid fa-brain text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-black tracking-tight">Neural Core <span class="text-primary font-light">v5.5</span></h2>
                        <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest opacity-50">
                            <span class="inline-block h-2 w-2 rounded-full bg-success animate-pulse"></span>
                            System Online
                        </div>
                    </div>
                </div>
                <form asp-controller="Ai" asp-action="ClearHistory" method="post" id="clearForm">
                    <button type="button" class="btn btn-ghost btn-sm btn-square hover:bg-error/10 hover:text-error" title="Wipe History" onclick="clearHistory()">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </form>
            </div>

            @* Messages area *@
            <div id="chatMessages" class="flex-1 max-h-[500px] overflow-y-auto p-6 space-y-6 bg-[radial-gradient(circle_at_center,_var(--color-base-200)_0%,_transparent_100%)]">
                <div class="chat chat-start">
                    <div class="chat-image avatar">
                        <div class="w-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-bold shadow-md">
                            AI
                        </div>
                    </div>
                    <div class="chat-header opacity-50 text-[10px] font-black mb-1 px-1">SYSTEM_INIT</div>
                    <div class="chat-bubble bg-base-200 text-base-content border border-base-300 shadow-sm leading-relaxed max-w-[90%]">
                        Neural handshake complete. I have full access to the <strong>Product Repository</strong> and <strong>Memory Buffers</strong>. How can I assist your workflow?
                    </div>
                </div>
            </div>

            @* Input Area *@
            <div class="p-6 bg-base-200/30 border-t border-base-300">
                <div class="relative group">
                    <textarea id="userInput" rows="1" placeholder="Enter command or query..." 
                              class="textarea textarea-bordered w-full min-h-[60px] bg-base-100 focus:ring-4 focus:ring-primary/5 transition-all text-base pr-20 py-4 resize-none shadow-inner"></textarea>
                    
                    <div class="absolute right-3 bottom-3 flex items-center gap-2">
                        <kbd class="kbd kbd-sm opacity-30 hidden sm:inline-flex">Enter</kbd>
                        <button id="sendBtn" type="button" class="btn btn-primary btn-md shadow-lg shadow-primary/20" onclick="sendMessage()">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
                <div class="mt-3 flex items-center justify-between px-2 text-[10px] font-bold uppercase tracking-widest opacity-40">
                    <span>Markdown formatting supported</span>
                    <span>Tokens: -- / --</span>
                </div>
            </div>
        </div>
    </div>

    @* Status Sidebar *@
    <div class="lg:col-span-4 space-y-6">
        @* Capabilities Card *@
        <div class="card bg-base-100 border border-base-300 shadow-xl p-6">
            <h3 class="text-sm font-black tracking-widest uppercase mb-4 flex items-center gap-2">
                <i class="fa-solid fa-microchip text-primary"></i> 
                Active Modules
            </h3>
            <div class="space-y-3">
                <div class="flex items-center justify-between p-3 rounded-xl bg-base-200 border border-base-300 transition-all hover:border-primary/30">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-memory text-secondary"></i>
                        <span class="text-xs font-bold">Persistence Engine</span>
                    </div>
                    <div class="badge badge-success badge-sm badge-soft">Enabled</div>
                </div>
                <div class="flex items-center justify-between p-3 rounded-xl bg-base-200 border border-base-300 transition-all hover:border-accent/30">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-bolt text-accent"></i>
                        <span class="text-xs font-bold">Function Invocation</span>
                    </div>
                    <div class="badge badge-success badge-sm badge-soft">Enabled</div>
                </div>
                <div class="flex items-center justify-between p-3 rounded-xl bg-base-200 border border-base-300 transition-all hover:border-success/30">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-database text-success"></i>
                        <span class="text-xs font-bold">Real-time Inventory</span>
                    </div>
                    <div class="badge badge-success badge-sm badge-soft">Enabled</div>
                </div>
            </div>
        </div>

        @* Usage Insights *@
        <div class="card bg-linear-to-br from-primary to-secondary text-primary-content p-6 shadow-xl">
            <h3 class="text-sm font-black tracking-widest uppercase mb-4 flex items-center gap-2 opacity-80">
                <i class="fa-solid fa-chart-line"></i> 
                Live Metrics
            </h3>
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10">
                    <div class="text-[10px] uppercase font-bold opacity-60">Latency</div>
                    <div class="text-xl font-black">1.2s</div>
                </div>
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10">
                    <div class="text-[10px] uppercase font-bold opacity-60">Accuracy</div>
                    <div class="text-xl font-black">99.8%</div>
                </div>
            </div>
            <div class="mt-4 pt-4 border-t border-white/10 text-center text-xs font-medium opacity-70">
                Connected via Groq Llama-3.3-70b
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const messagesEl = document.getElementById('chatMessages');
    const inputEl    = document.getElementById('userInput');
    const sendBtn    = document.getElementById('sendBtn');

    // Auto-expand textarea
    inputEl.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = (this.scrollHeight) + 'px';
    });

    inputEl.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    function appendBubble(text, type) {
        const wrap = document.createElement('div');
        wrap.className = type === 'user' ? 'chat chat-end' : 'chat chat-start';
        
        const header = document.createElement('div');
        header.className = 'chat-header opacity-50 text-[10px] font-black mb-1 px-1';
        header.textContent = type === 'user' ? 'AUTHORIZED_USER' : 'CORE_AI';

        const img = document.createElement('div');
        img.className = 'chat-image avatar';
        img.innerHTML = type === 'user' 
            ? '<div class="w-10 rounded-xl bg-neutral text-neutral-content flex items-center justify-center font-bold shadow-md">ME</div>'
            : '<div class="w-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-bold shadow-md">AI</div>';

        const bubble = document.createElement('div');
        bubble.className = type === 'user'
            ? 'chat-bubble bg-primary text-primary-content shadow-lg shadow-primary/10 border-none max-w-[90%]'
            : 'chat-bubble bg-base-200 text-base-content border border-base-300 shadow-sm leading-relaxed max-w-[90%]';
        
        bubble.textContent = text;
        
        wrap.appendChild(img);
        wrap.appendChild(header);
        wrap.appendChild(bubble);
        messagesEl.appendChild(wrap);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function showTyping() {
        const wrap = document.createElement('div');
        wrap.className = 'chat chat-start';
        wrap.id = 'typingIndicator';
        const img = document.createElement('div');
        img.className = 'chat-image avatar';
        img.innerHTML = '<div class="w-10 rounded-xl bg-primary text-primary-content flex items-center justify-center font-bold shadow-md">AI</div>';
        const inner = document.createElement('div');
        inner.className = 'chat-bubble bg-base-200 border border-base-300 flex items-center py-4 px-6';
        inner.innerHTML = '<span class="loading loading-dots loading-md text-primary"></span>';
        wrap.appendChild(img);
        wrap.appendChild(inner);
        messagesEl.appendChild(wrap);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function hideTyping() {
        document.getElementById('typingIndicator')?.remove();
    }

    async function sendMessage() {
        const msg = inputEl.value.trim();
        if (!msg) return;

        inputEl.value = '';
        inputEl.style.height = 'auto';
        sendBtn.disabled = true;

        appendBubble(msg, 'user');
        showTyping();

        const reply = await api('/Ai/AskAdvancedAsync', 'POST', msg);

        hideTyping();

        if (reply !== null) {
            appendBubble(reply, 'ai');
        }

        sendBtn.disabled = false;
        inputEl.focus();
    }

    function clearHistory() {
        if (!confirm('INITIATE_DATA_WIPE: Clear neural memory buffers?')) return;
        document.getElementById('clearForm').submit();
    }
</script>
}

