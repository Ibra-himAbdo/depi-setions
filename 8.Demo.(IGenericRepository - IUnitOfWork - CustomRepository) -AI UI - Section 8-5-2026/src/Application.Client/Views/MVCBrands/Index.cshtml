@model IReadOnlyList<ProductBrand>

@{
    ViewData["Title"] = Resource.Brands;
}

<div class="py-4">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 class="m-0 text-2xl font-semibold">@Resource.Brands</h2>
        <a class="btn btn-primary" asp-action="Create">@Resource.CreateBrand</a>
    </div>

    @if (TempData["ErrorMessage"] is string err && !string.IsNullOrEmpty(err))
    {
        <div role="alert" class="alert alert-error mb-4">@err</div>
    }

    @if (Model.Count == 0)
    {
        <div role="alert" class="alert alert-info">@Resource.NoBrandsFound</div>
    }
    else
    {
        <div class="overflow-x-auto rounded-lg border border-base-300">
            <table class="table table-zebra">
                <thead>
                    <tr>
                        <th>@Resource.ProductName</th>
                        <th>@Resource.ProductNameSecondLanguage</th>
                        <th class="text-end">@Resource.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var brand in Model)
                    {
                        <tr>
                            <td>@brand.Name</td>
                            <td>@brand.NameSecondLanguage</td>
                            <td class="text-end">
                                <a class="btn btn-outline btn-sm" asp-action="Update" asp-route-id="@brand.Id">@Resource.Update</a>
                                <a class="btn btn-error btn-outline btn-sm ms-1" asp-action="Delete" asp-route-id="@brand.Id">@Resource.Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
