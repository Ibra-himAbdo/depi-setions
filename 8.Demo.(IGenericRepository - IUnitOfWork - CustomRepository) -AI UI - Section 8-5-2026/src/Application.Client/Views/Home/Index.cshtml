@{
    ViewData["Title"] = "Home Page";
}

<div class="hero bg-base-200 rounded-box py-12">
    <div class="hero-content text-center">
        <div class="max-w-lg">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <h1 class="text-4xl font-bold">@Resource.Welcome @(User.Claims.FirstOrDefault(e => e.Type == ClaimTypes.GivenName)?.Value)</h1>
            }
            else
            {
                <h1 class="text-4xl font-bold">@Resource.Welcome</h1>
            }
            <p class="mt-4 py-2 text-base-content/80">
                Learn about <a href="https://learn.microsoft.com/aspnet/core" class="link link-primary">building Web apps with ASP.NET Core</a>.
            </p>
        </div>
    </div>
</div>
