@{
    var culture = CultureInfo.CurrentUICulture;
    var currentCulture = culture.Name;
    var isRtl = culture.TextInfo.IsRightToLeft;
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")" data-theme="corporate">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Authentication</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Application.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/toastify-js/toastify.min.css">
    <script src="~/lib/toastify-js/toastify.min.js"></script>
    <script src="~/js/toast-wrapper.js"></script>
    <partial name="_ToastNotificationPartial" />

</head>
<body class="flex min-h-screen items-center justify-center bg-gradient-to-br from-primary to-secondary p-4 overflow-x-hidden overflow-y-auto">
    <div class="w-full max-w-md overflow-visible">
        <div class="mb-8 text-center text-3xl font-bold text-primary-content drop-shadow-md">
            <i class="fas fa-shield-alt me-2"></i> @Resource.Welcome
        </div>

        <div class="relative z-[200] mb-2 flex justify-end overflow-visible">
            <details class="dropdown dropdown-end">
                <summary class="btn btn-sm border-primary-content/40 text-primary-content btn-outline cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <i class="fas fa-globe"></i>
                </summary>
                <ul class="menu dropdown-content z-[300] min-w-[12rem] rounded-box bg-base-100 p-2 shadow-lg">
                    @foreach (var langCode in ApplicationConstants.SupportedCultures)
                    {
                        var cultureInfo = new CultureInfo(langCode);
                        <li>
                            <a class="@(currentCulture == langCode ? "active" : null)"
                               asp-controller="Home" asp-action="ChangeLanguage"
                               asp-route-selectedLanguageCode="@langCode"
                               asp-route-returnUrl="@Context.Request.GetEncodedPathAndQuery()">
                                @cultureInfo.NativeName
                            </a>
                        </li>
                    }
                </ul>
            </details>
        </div>

        <div class="card bg-base-100 shadow-2xl">
            <div class="card-body p-6 md:p-8">
                @RenderBody()
            </div>
        </div>

        <div class="mt-4 text-center">
            <a href="/" class="link link-hover text-sm text-primary-content/90">
                <i class="fas fa-arrow-left me-1"></i> @Resource.Home
            </a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
