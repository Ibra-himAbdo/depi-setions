@model TodoItem

@{
    ViewData["Title"] = "Delete Page";
}

<form asp-action="Delete">
    <div class="row mb-3">
        <input asp-for="Id" class="d-none" />
        <label asp-for="Content">Task Content</label>
        <input class="form-control" asp-for="Content" disabled>
    </div>
    <button type="submit" class="btn btn-primary">Delete</button>
</form>